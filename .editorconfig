# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.md]
max_line_length = off

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
